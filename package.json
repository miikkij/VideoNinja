{
  "name": "video-ninja",
  "version": "1.2.0",
  "description": "A desktop video download queue built with Electron and yt-dlp",
  "main": "src/main/index.js",
  "scripts": {
    "start": "node scripts/start.js",
    "clean": "rimraf dist node_modules/.cache",
    "build": "electron-builder --config scripts/build-config.cjs --publish never",
    "build:mac": "electron-builder --config scripts/build-config.cjs --mac --publish never",
    "build:win": "electron-builder --config scripts/build-config.cjs --win --publish never",
    "build:linux": "electron-builder --config scripts/build-config.cjs --linux --publish never",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "lint": "eslint src/ scripts/ tests/ *.mjs --max-warnings 0",
    "lint:fix": "eslint src/ scripts/ tests/ *.mjs --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "test": "vitest run",
    "check": "pnpm lint && pnpm test",
    "audit": "pnpm audit --audit-level high && pnpm audit --prod",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:media": "node scripts/media-smoke.mjs",
    "test:features": "node scripts/features-smoke.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "keywords": [
    "youtube",
    "downloader",
    "yt-dlp",
    "video",
    "electron"
  ],
  "author": "VideoNinja",
  "homepage": "https://github.com/miikkij/VideoNinja",
  "repository": {
    "type": "git",
    "url": "https://github.com/miikkij/VideoNinja.git"
  },
  "license": "MIT",
  "dependencies": {
    "electron-store": "^12.0.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "js-yaml": "4.3.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.videoninja.app",
    "productName": "VideoNinja",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/assets/icons/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "src/assets/icons/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Utility",
      "maintainer": "VideoNinja",
      "icon": "src/assets/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "npmRebuild": false
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
